# Copy to .env for `docker compose`. All values have safe defaults, so this
# file is optional. Compose automatically reads a file named `.env`.

# Host port the production frontend is published on
FRONTEND_PORT=8080

# Backend the nginx container proxies API calls to.
#   - Backend running on the host:        http://host.docker.internal:8000
#   - Backend in the same compose network: http://api:8000
BACKEND_URL=http://host.docker.internal:8000

# Dev-only: where the Vite dev server proxies API calls (docker-compose.dev.yml)
VITE_API_PROXY_TARGET=http://host.docker.internal:8000
