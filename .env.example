# Base URL of the FastAPI backend.
# In dev you can leave this empty to use the Vite proxy (recommended).
# In production set it to the deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Used ONLY by the Vite dev-server proxy (not shipped to the browser).
VITE_API_PROXY_TARGET=http://localhost:8000

# AUTH: JWT (Bearer). Konfigürasyon GEREKMEZ — kullanıcı uygulama içindeki Login
# ekranından giriş yapar (POST /auth/login), token tarayıcıda saklanır ve her isteğe
# `Authorization: Bearer <token>` olarak eklenir. (Eski X-API-Key kaldırıldı.)
# Dev demo hesabı: admin / changeme123 (backend JWT_SECRET boşken otomatik seed'lenir).
